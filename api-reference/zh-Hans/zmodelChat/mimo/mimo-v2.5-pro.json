                      {
                        "role": "user",
                        "content": "请介绍一下你自己"
                      }
                    ],
                    "max_completion_tokens": 1024,
                    "temperature": 1,
                    "top_p": 0.95,
                    "stream": false,
                    "stop": null,
                    "frequency_penalty": 0,
                    "presence_penalty": 0,
