{
  "openapi": "3.0.1",
  "info": {
    "title": "MiniMax-M2.5-highspeed",
    "version": "1.0.0",
    "description": "历史 MiniMax（`type=35`）通道对话能力文档。公开统一入口为 `/v1/chat/completions`，当前网关会将请求转发到上游 `POST /v1/text/chatcompletion_v2`，并沿用 OpenAI Chat Completions 兼容的请求与响应结构。\n\n本文档只描述当前网关已稳定透传且与 MiniMax OpenAI 兼容能力一致的字段子集：`model`、`messages`、`temperature`、`top_p`、`max_tokens`、`stream`。"
  },
  "servers": [
    {
      "url": "https://baze-api.powerbuyin.top",
      "description": "Baze API 服务地址"
    }
  ],
  "tags": [
    {
      "name": "MiniMax Chat",
      "description": "历史 MiniMax OpenAI 兼容对话能力"
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "MiniMax-M2.5-highspeed",
        "description": "调用历史 MiniMax OpenAI 兼容聊天模型。当前稳定模型为 MiniMax-M2.5-highspeed`。",
        "operationId": "minimaxChatCompletions",
        "x-capability": "chat",
        "tags": [
          "MiniMax Chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "非流式对话",
                  "value": {
                    "model": "MiniMax-M2.5-highspeed",
                    "messages": [
                      {
                        "role": "system",
                        "content": "你是一个简洁的助手。"
                      },
                      {
                        "role": "user",
                        "content": "请用一句话介绍巴黎。"
                      }
                    ],
                    "temperature": 0.3
                  }
                },
                "stream": {
                  "summary": "流式对话",
                  "value": {
                    "model": "MiniMax-M2.5-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Count from one to five."
                      }
                    ],
                    "stream": true
                  }
                },
                "multi_turn_chat": {
                  "summary": "多轮对话（携带历史上下文续聊）",
                  "value": {
                    "model": "MiniMax-M2.5-highspeed",
                    "messages": [
                      {
                        "role": "system",
                        "content": "你是一个简洁、准确的中文助手。"
                      },
                      {
                        "role": "user",
                        "content": "介绍一下向量数据库的典型使用场景。"
                      },
                      {
                        "role": "assistant",
                        "content": "向量数据库常用于语义检索、推荐系统和 RAG 知识库：先把文本等数据编码为向量，再按相似度召回最相关的结果。"
                      },
                      {
                        "role": "user",
                        "content": "那它在 RAG 中承担什么职责？"
                      }
                    ],
                    "stream": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "调用成功。非流式返回 OpenAI 兼容 JSON；流式返回 OpenAI 兼容 SSE 事件流。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE 数据流。每个 `data:` 事件都可按 OpenAI Chat Completions Chunk 解析；结束时通常返回 `data: [DONE]`。"
                },
                "description": "流式 chunk 同样携带 `requested_model` 与 `resolved_model` 字段。若客户端在流完成前断开连接，平台将停止转发后续 chunk；此时未收到完整用量，`usage` 保持未知（不会以 `0` 填充），请勿将缺省用量计入成本。",
                "examples": {
                  "stream_interrupted": {
                    "summary": "流被中断时 usage 保持未知（不填 0）",
                    "description": "客户端在流完成前断开连接：已收到的 chunk 不含最终 usage，且不会收到收尾的 usage chunk，用量保持未知。",
                    "value": "data: {\"id\":\"chatcmpl_interrupted_001\",\"object\":\"chat.completion.chunk\",\"created\":1763000000,\"model\":\"MiniMax-M2.5-highspeed\",\"requested_model\":\"MiniMax-M2.5-highspeed\",\"resolved_model\":null,\"choices\":[{\"index\":0,\"delta\":{\"content\":\"…\"},\"finish_reason\":null}]}\n\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "传入模型不支持的参数时显式报错（不静默忽略）",
                    "value": {
                      "error": {
                        "message": "模型 MiniMax-M2.5-highspeed 不支持参数 `reasoning_effort`。平台不会静默忽略不支持的参数，请移除该参数后重试。",
                        "type": "invalid_request_error",
                        "param": "reasoning_effort",
                        "code": "unsupported_parameter"
                      }
                    }
                  },
                  "json_schema_not_supported": {
                    "summary": "不支持 json_schema 时显式报错",
                    "value": {
                      "error": {
                        "message": "模型 MiniMax-M2.5-highspeed 不支持 `response_format` 参数（含 `json_schema`），平台不会静默忽略该参数，请移除后重试。",
                        "type": "invalid_request_error",
                        "param": "response_format",
                        "code": "json_schema_not_supported"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Token",
        "description": "在请求头中传入 `Authorization: Bearer <token>`。"
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "MiniMax-M2.5-highspeed"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.7
          },
          "top_p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 2048,
            "minimum": 1
          },
          "stream": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "user_system",
              "group",
              "sample_message_user",
              "sample_message_ai"
            ],
            "description": "消息发送者的角色system: 设定模型的角色和行为\nuser: 用户的输入\nassistant: 模型的历史回复\nuser_system: 设定用户的角色和人设\ngroup: 对话的名称\nsample_message_user: 示例的用户输入\nsample_message_ai: 示例的模型输出"
          },
          "content": {
            "type": "string",
            "description": "消息内容。M2.5-highspeed 仅支持纯文本输入。"
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "usage": {
            "type": "object",
            "description": "计费口径：输入与输出 token 均计费。该模型未公开缓存/推理 token 明细，用量以平台账单为准。流式请求在完成前被中断且未取得完整用量时，`usage` 保持未知状态（相关字段缺省），不会以 `0` 填充。"
          },
          "requested_model": {
            "type": "string",
            "description": "平台收到的请求中 `model` 字段的原始值，即我方请求的模型。"
          },
          "resolved_model": {
            "type": "string",
            "nullable": true,
            "description": "实际执行的模型。当上游渠道未披露实际模型时返回 `null`，平台不会伪造该值。"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorObject"
          }
        }
      },
      "ErrorObject": {
        "type": "object",
        "required": [
          "message",
          "type",
          "param",
          "code"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "param": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
